APP_ENV=production
APP_URL=https://natcodev.com.ng
APP_TIMEZONE=Africa/Lagos
APP_KEY=generate-a-long-random-app-key

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=natcodevcom_data
DB_USERNAME=natcodevcom_data
DB_PASSWORD=change-this

ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=put-password-hash-here
ADMIN_NOTIFY_EMAIL=info@coconutventurehub.ng

JWT_SECRET=generate-a-long-random-jwt-secret

MAIL_FROM_NAME=NATCODEV
MAIL_FROM_ADDRESS=noreply@coconutventurehub.ng
MAIL_REPLY_TO=info@coconutventurehub.ng
MAIL_TRANSPORT=mail

SMS_TRANSPORT=sendchamp
WHATSAPP_TRANSPORT=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_MESSAGING_SERVICE_SID=

SENDCHAMP_BASE_URL=https://api.sendchamp.com/api/v1
SENDCHAMP_ACCESS_KEY=
SENDCHAMP_SENDER_NAME=NATCODEV
SENDCHAMP_ROUTE=dnd

MONNIFY_BASE_URL=https://api.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT_NUMBER=
MONNIFY_PAYMENT_METHODS=CARD,USSD,DIRECT_DEBIT,ACCOUNT_TRANSFER
MONNIFY_SSL_VERIFY=true
MONNIFY_PREFERRED_BANK_CODES=
MONNIFY_BVN_VERIFICATION_ENDPOINT=/api/v1/vas/bvn-details-match
MONNIFY_NIN_VERIFICATION_ENDPOINT=/api/v1/vas/nin-details-match

ADMIN_WALLET_FUNDING_MAX_AMOUNT=10000000
