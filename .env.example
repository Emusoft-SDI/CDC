APP_ENV=production
APP_URL=https://natcodev.com.ng
APP_TIMEZONE=Africa/Lagos
APP_KEY=generate-a-long-random-app-key

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=natcodevcom_data
DB_USERNAME=natcodevcom_data
DB_PASSWORD=change-this

ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=put-password-hash-here
ADMIN_NOTIFY_EMAIL=info@coconutventurehub.ng

JWT_SECRET=generate-a-long-random-jwt-secret

MAIL_FROM_NAME=NATCODEV
MAIL_FROM_ADDRESS=noreply@coconutventurehub.ng
MAIL_REPLY_TO=info@coconutventurehub.ng
MAIL_TRANSPORT=mail

SMS_TRANSPORT=sendchamp
WHATSAPP_TRANSPORT=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_MESSAGING_SERVICE_SID=

SENDCHAMP_BASE_URL=https://api.sendchamp.com/api/v1
SENDCHAMP_ACCESS_KEY=
SENDCHAMP_SENDER_NAME=NATCODEV
SENDCHAMP_ROUTE=dnd

MONNIFY_BASE_URL=https://api.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT_NUMBER=
# Optional. The name on the Monnify wallet account. Monnify wants it on a single
# disbursement; when it is blank the field is simply omitted from the request.
MONNIFY_WALLET_ACCOUNT_NAME=
MONNIFY_PAYMENT_METHODS=CARD,USSD,DIRECT_DEBIT,ACCOUNT_TRANSFER
MONNIFY_SSL_VERIFY=true
MONNIFY_PREFERRED_BANK_CODES=
MONNIFY_BVN_VERIFICATION_ENDPOINT=/api/v1/vas/bvn-details-match
MONNIFY_NIN_VERIFICATION_ENDPOINT=/api/v1/vas/nin-details-match

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_IS_LIVE=false

FINCRA_BASE_URL=https://sandbox-api.fincra.com
FINCRA_PUBLIC_KEY=
FINCRA_SECRET_KEY=
FINCRA_BUSINESS_ID=
FINCRA_WEBHOOK_KEY=

WOVEN_BASE_URL=https://api.woven.finance
WOVEN_API_KEY=
WOVEN_API_SECRET=

KORAPAY_BASE_URL=https://api.korapay.com/merchant/api/v1
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
KORAPAY_ENCRYPTION_KEY=

ALLAWEE_BASE_URL=https://api.allawee.com
ALLAWEE_API_KEY=
ALLAWEE_WEBHOOK_SECRET=

FLUTTERWAVE_SECRET_KEY=
# Shared verification hash for Flutterwave webhook requests (verif-hash header).
FLUTTERWAVE_SECRET_HASH=

TERMII_API_KEY=
# Shared HMAC-SHA256 secret for the USSD payment callback (ussd-callback.php).
USSD_CALLBACK_SECRET=
