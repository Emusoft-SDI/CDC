{
  "openapi": "3.0.0",
  "info": {
    "title": "NATCODEV Mobile API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://apply.coconutventurehub.ng/api/mobile"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {"type": "string"},
                  "password": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {"type": "string"},
                    "user": {"type": "object"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/marketplace": {
      "get": {
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "Marketplace items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/MarketplaceItem"}
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "MarketplaceItem": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "title": {"type": "string"},
          "price": {"type": "number"}
        }
      }
    }
  }
}