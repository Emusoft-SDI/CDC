Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^(config\.php|composer\.(json|lock)|package(-lock)?\.json)$ - [F,L,NC]
  RewriteRule ^(lib|cron|tests|private_backups)(/|$) - [F,L,NC]
  RewriteRule \.(env|log|bak|backup|old|sql|sqlite|ini|ps1|sh|txt)$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
</IfModule>
